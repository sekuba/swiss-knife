# Copy to .env in the repository root (or one directory above it) and adjust.
# After any change: selfhost/update.sh --rebuild
# No quotes around values.

# Public origin of this deployment.
NEXT_PUBLIC_SITE_URL=https://eth.example.org

# PUBLIC: NEXT_PUBLIC_* values are shipped to every visitor's browser. Never
# put a key-bearing RPC URL here. Leave empty to use the built-in public RPCs.
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# WalletConnect / Reown project id (public by design). Allowlist your origin
# for it at https://cloud.reown.com.
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional: where this build's source is published (footer link).
NEXT_PUBLIC_SOURCE_URL=

# SECRET, server only. Etherscan v2 key (one key covers all chains): verified
# source, ABIs and contract names for the explorer and decoder.
ETHERSCAN_API_KEY=

# Optional: loopback port the container is published on (default 3947).
# ETHSH_PORT=3947
